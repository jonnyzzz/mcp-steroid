{
  "description": "Nudge to /devrig:setup when devrig is missing, show download progress passively, and steer recovery when a devrig tool hits a recoverable error.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__devrig__.*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/devrig-recover"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/check-devrig"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/devrig-progress"
          }
        ]
      }
    ]
  }
}
