#!/bin/sh
# devrig -- one-time installer wrapper (macOS/Linux).
# Run by the /devrig:setup slash command. Delegates to the canonical, signed
# installer; we deliberately do NOT re-implement platform detection, checksum, or
# JDK download (all owned by :installer-gen + the devrig binary)
# All diagnostic output goes to stderr

set -eu

# TODO: Probably temp, i'll think about putting it into some config
INSTALL_URL="https://mcp-steroid.jonnyzzz.com/install.sh"
DEVRIG="$HOME/.mcp-steroid/bin/devrig"

echo "devrig: installing devrig via $INSTALL_URL" >&2

if command -v curl >/dev/null 2>&1; then
  curl -fsSL "$INSTALL_URL" | sh >&2
elif command -v wget >/dev/null 2>&1; then
  wget -qO- "$INSTALL_URL" | sh >&2
else
  echo "devrig: need curl or wget to install devrig" >&2
  exit 1
fi

# The canonical installer is idempotent; verify it actually produced the launcher so a
# truncated download or interrupted run fails loudly instead of looking successful
if [ ! -x "$DEVRIG" ]; then
  echo "devrig: install finished but devrig was not found at $DEVRIG" >&2
  echo "devrig: the install may have been interrupted -- run /devrig:setup again" >&2
  exit 1
fi

echo "devrig: devrig installed at $DEVRIG" >&2
echo "devrig: restart Claude so the devrig MCP server can start" >&2
