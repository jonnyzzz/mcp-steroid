#!/bin/sh
# devrig -- SessionStart hook. The plugin registers its MCP server via .mcp.json and the bundled
# bootstrap downloads devrig in the background. This hook ONLY surfaces download progress; it never
# nags about registration (the .mcp.json guarantees it, and plugin-scoped registration does not
# appear in ~/.claude.json). Stays silent once devrig is installed. Must be fast and exit 0.
DEVRIG="$HOME/.mcp-steroid/bin/devrig"
DEVRIG_WIN="$HOME/.mcp-steroid/bin/devrig.cmd"

# Installed -> the launcher proxies the real server; nothing to say.
if [ -x "$DEVRIG" ] || [ -f "$DEVRIG_WIN" ]; then
  exit 0
fi

# Not installed yet -> the bootstrap is serving a green server and downloading in the background.
cat <<'EOF'
{
  "systemMessage": "devrig is downloading in the background (~300 MB). The bridge is in bootstrap mode now; restart Claude once it finishes to activate the full IDE. Run /devrig:setup to fetch it immediately.",
  "hookSpecificOutput": {
    "hookEventName": "SessionStart",
    "additionalContext": "The devrig MCP server is registered (plugin .mcp.json) and currently running in bootstrap mode while the ~300 MB devrig binary downloads in the background. The agent can call the devrig_setup tool to check progress. Once installed, the user must restart Claude so the launcher routes to the full devrig server. /devrig:setup pre-downloads it immediately."
  }
}
EOF
exit 0
