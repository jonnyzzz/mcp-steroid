#!/bin/sh
# devrig -- SessionStart hook. The plugin registers its MCP server via .mcp.json and the bundled
# bootstrap downloads devrig in the background. This hook only surfaces state to the user; it never
# nags about registration (the .mcp.json guarantees it). It stays silent once devrig is installed,
# tells the user to keep Claude open while downloading (tools activate automatically — no restart
# needed), and points at /devrig:setup ONLY if the last install attempt failed. Must be fast and
# exit 0.
DEVRIG="$HOME/.mcp-steroid/bin/devrig"
DEVRIG_WIN="$HOME/.mcp-steroid/bin/devrig.cmd"
FAILED="$HOME/.mcp-steroid/markers/bootstrap-install.failed"

# Installed -> the launcher proxies the real server; nothing to say.
if [ -x "$DEVRIG" ] || [ -f "$DEVRIG_WIN" ]; then
  exit 0
fi

# Last install attempt failed -> point at the manual retry (the ONE place /devrig:setup is surfaced).
if [ -f "$FAILED" ]; then
  cat <<'EOF'
{
  "systemMessage": "❌ devrig couldn't finish installing. Run /devrig:setup to retry, then restart Claude.",
  "hookSpecificOutput": {
    "hookEventName": "SessionStart",
    "additionalContext": "The devrig background install failed (~/.mcp-steroid/markers/bootstrap-install.failed exists). Tell the user to run /devrig:setup to retry the download, then restart Claude. Use the devrig_status tool for the failure detail."
  }
}
EOF
  exit 0
fi

# Downloading in the background -> reassure the user; the download is detached and tools activate
# automatically. Do NOT mention /devrig:setup here.
cat <<'EOF'
{
  "systemMessage": "⏳ devrig is installing in the background (~500 MB). It keeps downloading even if you close or restart Claude — no need to wait around. When it finishes, the full IDE toolset activates automatically on your next message — no restart needed. Ask me for devrig status anytime to see progress.",
  "hookSpecificOutput": {
    "hookEventName": "SessionStart",
    "additionalContext": "The devrig MCP server is registered (plugin .mcp.json) and currently running in bootstrap mode while the ~500 MB devrig binary downloads in the background. The download runs in a DETACHED process, so it continues even if the user quits or restarts Claude — you do NOT need to tell them to keep Claude open. Call the devrig_status tool to report download progress when the user asks. Once the download finishes, the bootstrap fires tools/list_changed and the full IDE toolset activates automatically on the user's next message — no restart needed. While it is still downloading, do not tell the user to run any manual install command -- just let it finish."
  }
}
EOF
exit 0
