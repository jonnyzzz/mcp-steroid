#!/bin/sh
# devrig -- SessionStart hook. The plugin registers its MCP server via .mcp.json and the bundled
# bootstrap downloads devrig in the background. This hook only surfaces state to the user; it never
# nags about registration (the .mcp.json guarantees it). Once devrig is installed it shows a ONE-TIME
# welcome (marker-gated) with example prompts, then stays silent on every later session. While
# downloading it tells the user to keep Claude open (tools activate automatically — no restart needed),
# and points at /devrig:setup ONLY if the last install attempt failed. Must be fast and exit 0.
DEVRIG="$HOME/.mcp-steroid/bin/devrig"
DEVRIG_WIN="$HOME/.mcp-steroid/bin/devrig.cmd"
FAILED="$HOME/.mcp-steroid/markers/bootstrap-install.failed"
WELCOMED="$HOME/.mcp-steroid/markers/welcomed"

# Resolve the bundled bootstrap binary for this OS/arch (used to query the size and manage the bar).
ROOT="${CLAUDE_PLUGIN_ROOT:-$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)}"
os=$(uname -s | tr '[:upper:]' '[:lower:]'); case "$os" in darwin) os=darwin;; linux) os=linux;; esac
arch=$(uname -m); case "$arch" in x86_64|amd64) arch=amd64;; arm64|aarch64) arch=arm64;; esac
BOOT="$ROOT/bin/bootstrap-$os-$arch"

# Total download size in MB — single source of truth is approxInstallMB in the bootstrap.
SIZE=611
[ -x "$BOOT" ] && SIZE=$("$BOOT" --install-size-mb 2>/dev/null || echo 611)

# Installed -> the launcher proxies the real server.
if [ -x "$DEVRIG" ] || [ -f "$DEVRIG_WIN" ]; then
  # Self-heal: if a transient progress bar was left in settings.json (e.g. after a hard kill), remove it.
  # The --remove-statusline call is a no-op unless the statusLine is ours, so a user's own bar is safe.
  if grep -q '"statusLine"' "$HOME/.claude/settings.json" 2>/dev/null; then
    [ -x "$BOOT" ] && "$BOOT" --remove-statusline >/dev/null 2>&1
  fi
  # First run after install -> welcome the user ONCE with copy-paste examples, then never again. The
  # marker guards it so every later session stays silent. Curly quotes keep the example prompts inside
  # the JSON string without escaping.
  if [ ! -f "$WELCOMED" ]; then
    mkdir -p "$HOME/.mcp-steroid/markers" 2>/dev/null
    : > "$WELCOMED" 2>/dev/null
    cat <<'EOF'
{
  "systemMessage": "✅ devrig is live — Claude can now drive your JetBrains IDE. Try “run the tests in the open IDE”, “find duplicates in this file”, or “show the compilation errors”. Run /devrig:help for more.",
  "hookSpecificOutput": {
    "hookEventName": "SessionStart",
    "additionalContext": "devrig is installed and the full IDE toolset is available. This is the user's first session since install — they may not know what the whole-IDE bridge can do. If they seem unsure how to start, suggest copy-paste example prompts such as “run the tests in the open IDE”, “find duplicates in this file”, “show the compilation errors in the project”, or “rename this symbol across the project”, and mention the /devrig:help command lists more. Do not run anything unprompted; only act on the user's actual request. A JetBrains IDE with the MCP Steroid plugin must be open for the IDE tools to connect."
  }
}
EOF
  fi
  exit 0
fi

# Last install attempt failed -> point at the manual retry (the ONE place /devrig:setup is surfaced).
if [ -f "$FAILED" ]; then
  cat <<'EOF'
{
  "systemMessage": "❌ devrig install failed. Run /devrig:setup to retry.",
  "hookSpecificOutput": {
    "hookEventName": "SessionStart",
    "additionalContext": "The devrig background install failed (~/.mcp-steroid/markers/bootstrap-install.failed exists). Tell the user to run /devrig:setup to retry the download, then restart Claude. Use the devrig_status tool for the failure detail."
  }
}
EOF
  exit 0
fi

# Downloading -> install the status-line bar NOW, at session start, so the instance that TRIGGERED the
# download shows the bar itself (not only other already-running instances that live-reload settings.json).
# This is a no-op / hook-mode when the user already has a status line (see applyStatusLineMode).
[ -x "$BOOT" ] && "$BOOT" --install-statusline >/dev/null 2>&1

# Is a running IDE with the MCP Steroid plugin already reachable? If so, the bootstrap bridges to its
# HTTP MCP endpoint (Tier 1) and the user has full IDE tools NOW, while the download continues. The
# plugin advertises the endpoint in ~/.mcp-steroid/markers/<pid>.mcp-steroid (mcpSteroidServer.baseUrl).
IDE_UP=0
for m in "$HOME"/.mcp-steroid/markers/*.mcp-steroid; do
  [ -f "$m" ] || continue
  if grep -q 'mcpSteroidServer' "$m" 2>/dev/null; then IDE_UP=1; break; fi
done

# Downloading in the background -> reassure the user; the download is detached and tools activate
# automatically. Do NOT mention /devrig:setup here.
if [ "$IDE_UP" = "1" ]; then
  cat <<EOF
{
  "systemMessage": "⚡ IDE tools ready now — full devrig toolset (~${SIZE} MB) still downloading in the background, activates automatically when done.",
  "hookSpecificOutput": {
    "hookEventName": "SessionStart",
    "additionalContext": "A running IDE with the MCP Steroid plugin is reachable, so the bootstrap has bridged to its HTTP MCP endpoint (Tier 1): the user ALREADY has the open IDE's tools. Meanwhile the ~${SIZE} MB devrig download continues in a DETACHED process (survives quit/restart). When it completes, the bootstrap fires tools/list_changed a second time and swaps to the full devrig backend (Tier 2, adds cross-backend/managed features) automatically on the user's next message — no restart. Call devrig_status for download progress. Do not tell the user to run any manual install command."
  }
}
EOF
  exit 0
fi
cat <<EOF
{
  "systemMessage": "⏳ devrig downloading (~${SIZE} MB) in the background — activates automatically when done, no restart needed.",
  "hookSpecificOutput": {
    "hookEventName": "SessionStart",
    "additionalContext": "The devrig MCP server is registered (plugin .mcp.json) and currently running in bootstrap mode while the ~${SIZE} MB devrig binary downloads in the background. The download runs in a DETACHED process, so it continues even if the user quits or restarts Claude — you do NOT need to tell them to keep Claude open. Call the devrig_status tool to report download progress when the user asks. Once the download finishes, the bootstrap fires tools/list_changed and the full IDE toolset activates automatically on the user's next message — no restart needed. While it is still downloading, do not tell the user to run any manual install command -- just let it finish."
  }
}
EOF
exit 0
