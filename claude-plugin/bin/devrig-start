#!/bin/sh
# MCP Steroid -- stdio MCP bridge launcher for macOS/Linux.
# stdout is the MCP JSON-RPC channel: nothing must be written to it before exec, therefore all diagnostic output goes to stderr

DEVRIG="$HOME/.mcp-steroid/bin/devrig"

if [ ! -x "$DEVRIG" ]; then
  echo "mcp-steroid: devrig not found at $DEVRIG" >&2
  echo "mcp-steroid: install devrig first — see https://mcp-steroid.jonnyzzz.com/docs/devrig/" >&2
  exit 1
fi

exec "$DEVRIG" mcp
