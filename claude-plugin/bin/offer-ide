#!/bin/sh
# devrig -- SessionStart hook. When devrig is installed, offer (ONCE per machine) to install the MCP
# Steroid IDE plugin into a running JetBrains IDE that doesn't have it yet. All of devrig's own output
# goes to stderr; this hook emits only a small additionalContext nudge on stdout. Never blocks; exit 0.
DEVRIG="$HOME/.mcp-steroid/bin/devrig"
DEVRIG_WIN="$HOME/.mcp-steroid/bin/devrig.cmd"
MARKER="$HOME/.mcp-steroid/markers/ide-offered"

# devrig not installed yet -> nothing to do (check-devrig handles the install nudge).
if [ ! -x "$DEVRIG" ] && [ ! -f "$DEVRIG_WIN" ]; then exit 0; fi

# Offer at most once per machine.
if [ -f "$MARKER" ]; then exit 0; fi
mkdir -p "$HOME/.mcp-steroid/markers" 2>/dev/null
: > "$MARKER" 2>/dev/null

# Run the offer; devrig decides (already-connected / no-IDE / install dialog / browser / manual) and
# prints its narration to stderr. We don't parse it -- we only surface a one-line nudge to the agent.
if [ -x "$DEVRIG" ]; then
  "$DEVRIG" connect ide >&2 2>&1 || true
fi

cat <<'EOF'
{
  "hookSpecificOutput": {
    "hookEventName": "SessionStart",
    "additionalContext": "devrig checked for a running JetBrains IDE without the MCP Steroid plugin and, if it found one, offered to install it (an IDE install dialog may have appeared, or a browser page opened). If the user wants IDE tools and no dialog appeared, tell them to install \"MCP Steroid\" via Settings > Plugins, or run /devrig:setup. Do not repeat this offer."
  }
}
EOF
exit 0
